# Database & Cache
DATABASE_URL=postgresql+psycopg2://dummr_user:dummr_password@localhost:5433/dummr_db
REDIS_URL=redis://localhost:6380/0

# Security & Tokens (SECRET_KEY must be at least 32 characters in production)
SECRET_KEY=change_me_to_a_random_32_character_string_for_security
JWT_SECRET_KEY=change_me_to_a_random_32_character_string_for_security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server & Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@dummr.com

# File Storage (local / s3 / cloudinary)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (razorpay / stripe)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
